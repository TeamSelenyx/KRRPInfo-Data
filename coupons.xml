<?xml version="1.0" encoding="UTF-8"?>
<!--
=====================================================================
 coupons.xml 사용 방법  (쿠폰 탭 아래 "목록" 버튼 → 쿠폰 코드 복사 메뉴)
=====================================================================
 - <coupon> 하나가 메뉴의 한 줄입니다. 줄을 누르면 <code> 가 클립보드에 복사됩니다.
 - 지금 표시할 쿠폰이 하나도 없으면, 버튼을 눌렀을 때
   "복사할 수 있는 쿠폰이 없어요" 토스트가 나옵니다.
 - 앱이 켜져 있는 동안 5분마다, 그리고 앱으로 돌아올 때 자동으로 다시 읽습니다.
   (기간은 메뉴를 열 때마다 "지금 시각" 기준으로 다시 확인합니다)

 [태그]
 <code>     (필수) 복사될 쿠폰 코드. 비어 있으면 그 항목은 무시됩니다.
 <name>     (선택) 메뉴에 보일 이름. 없으면 코드만 보입니다.
 <id>       (선택) 관리용 이름. 앱에는 보이지 않습니다.
 <startAt>  (선택) 이 시각부터 표시.   예) 2026-11-26T00:00:00
 <endAt>    (선택) 이 시각 전까지 표시. 예) 2026-12-31T23:59:59
            → 둘 다 생략하면 항상 표시, 하나만 적으면 그쪽만 제한됩니다.
 - 위에서부터 적은 순서대로 메뉴에 나옵니다.
=====================================================================
-->
<coupons>

  <coupon>
    <id>open_event</id>
    <name>오픈 기념 쿠폰</name>
    <code>KRRP-OPEN-2026</code>
    <startAt>2026-11-26T00:00:00</startAt>
    <endAt>2026-12-31T23:59:59</endAt>
  </coupon>

  <!-- 기간 없이 항상 표시되는 예시 -->
  <coupon>
    <name>테스트 쿠폰</name>
    <code>KRRP-ALWAYS</code>
  </coupon>

</coupons>
